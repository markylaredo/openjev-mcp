# openjev-mcp environment sample
#
# Copy the values you need into the `env` block of your MCP client config:
#
#   "openjev": {
#     "command": "node",
#     "args": ["/absolute/path/to/openjev-mcp/dist/index.js"],
#     "env": { "OPENJEV_API_KEY": "your-key" }
#   }
#
# The server reads the process environment; it does not load this file itself.
# For a local run, Node can load it directly (Node 20.6 and newer):
#
#   node --env-file=.env dist/index.js
#
# Copy to `.env`, fill in the key, and never commit that file.

# Required. Bearer token for the OpenJEV API.
# Create one at https://openjev.sh/dashboard. This key stays server-side: it must
# never reach an MCP client, a tool argument, or a prompt.
OPENJEV_API_KEY=

# Optional. API origin. Default: https://api.openjev.sh
# Set this only to point at a proxy or a local test double.
# OPENJEV_BASE_URL=https://api.openjev.sh

# Optional. Per-attempt timeout in milliseconds, 1000-600000. Default: 30000
# Retries get their own timeout each, so worst-case latency is roughly
# (OPENJEV_MAX_RETRIES + 1) x OPENJEV_TIMEOUT_MS plus backoff.
# OPENJEV_TIMEOUT_MS=30000

# Optional. Retries after the first attempt, 0-10. Default: 2
# Applies to 429, 5xx, timeouts, and network errors only; 401 and 422 are never
# retried, because repeating them cannot succeed.
# OPENJEV_MAX_RETRIES=2

# Optional. Model alias sent when a tool call does not name one.
# Unset uses the service default, `openjev`.
# OPENJEV_MODEL=openjev
