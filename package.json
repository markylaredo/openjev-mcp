{
  "name": "openjev-mcp",
  "version": "0.1.2",
  "description": "MCP server for typed AI judgments: classify, route, score, and flag with calibrated probabilities instead of prose. Powered by Jev via the OpenJEV API.",
  "mcpName": "io.github.markylaredo/openjev-mcp",
  "license": "MIT",
  "author": "markylaredo",
  "homepage": "https://github.com/markylaredo/openjev-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markylaredo/openjev-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/markylaredo/openjev-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "openjev",
    "jev",
    "typesafe",
    "classification",
    "llm-as-judge",
    "structured-output",
    "routing",
    "ai-agents",
    "claude",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "openjev-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.6.0"
  }
}
